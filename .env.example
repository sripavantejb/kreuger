# Copy to .env and fill in values. Never commit real passwords.

DATABASE_URL="mongodb://..."
AUTH_SECRET="change-me"

# --- Gmail alert delivery ---
# 1. Google Account → Security → 2-Step Verification → App passwords
# 2. Create an app password for "Mail"
# 3. Set ENABLE_EMAIL=true and fill the fields below

ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Kreuger Ops <your.name@gmail.com>"

# Optional: send EVERY alert to this Gmail (ignores per-role recipient emails while testing)
ALERT_GMAIL=your.name@gmail.com

# Aliases also supported:
# GMAIL_USER=your.name@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

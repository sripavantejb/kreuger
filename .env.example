# Copy to .env and fill in values. Never commit real passwords.

DATABASE_URL="mongodb://..."
AUTH_SECRET="change-me"
APP_BASE_URL="http://localhost:3000"

# --- Email delivery (Gmail App Password recommended) ---
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Alias also accepted:
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM="Kreuger Ops <your.name@gmail.com>"

# Recipients for Primary / Secondary heads are stored in Master Data (seeded as
# sripavantejb@gmail.com / harshapolinax@gmail.com) — edit there, not in code.

# --- RAG assistant (OpenAI-compatible) ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini


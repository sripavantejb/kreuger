// Manufacturing operations dashboard — data model
// See /BUILD_SPEC.md (in repo root, provided by MD) for the source spec.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Singleton row (id = 1) holding the tunable constants from the planning spec,
// plus the escalation contacts used when building Alerts.
//
// Doubles as the manpower-efficiency module's "PlanningConstants": procurementDays
// / rampDays / shiftHours are the same figures both scenarios share, just read as
// working days by the manpower module instead of calendar days. weeklyOff is the
// only field that module needed and this table didn't already have.
model Settings {
  id             Int   @id @map("_id")
  procurementDays Float @default(3)
  rampDays        Float @default(1.5)
  shiftHours      Float @default(8)
  weeklyOff       String[] @default(["Sunday"]) // day-of-week names, e.g. "Sunday"
  gstPercent      Float @default(18) // applied to every quotation's total in the BOQ-style PDF

  plantHeadName        String @default("Plant Head")
  plantHeadEmail       String @default("plant.head@kreuger.local")
  procurementHeadName  String @default("Procurement Head")
  procurementHeadEmail String @default("procurement.head@kreuger.local")
  dispatchHeadName     String @default("Dispatch Head")
  dispatchHeadEmail    String @default("dispatch.head@kreuger.local")
  salesCoordinatorName  String @default("Sales Coordinator")
  salesCoordinatorEmail String @default("sales.coordinator@kreuger.local")
}

// Named holidays excluded from working-day counts, alongside weeklyOff.
model Holiday {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime
  name String
}

// One user. Manager level. Desktop. — now Admin / Manager / Viewer.
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("VIEWER") // ADMIN | MANAGER | VIEWER
  createdAt    DateTime @default(now())
}

model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String   @unique
  baseRate  Float
  defaultLeadDays Int @default(14) // pre-fills target days / plan range for new OCs of this product
  description String @default("") // one spec per line; rendered as bullet points on the quotation PDF
  hsnCode   String   @default("") // HSN/SAC shown on Purchase Order PDFs

  materials       ProductMaterial[]
  departmentRates ProductDepartmentRate[]
  pricingSlabs    PricingSlab[]
  colourImages    ProductColourImage[]
  quotations      Quotation[]
  salesOrders     SalesOrder[]
  orders          OrderConfirmation[]
}

model Colour {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  hexCode String

  productImages ProductColourImage[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  orders        OrderConfirmation[]
}

// Product.imageByColour, modelled as a join table so it stays editable data.
// imagePath holds a data: URI uploaded from Master Data — no external file storage.
model ProductColourImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  colourId  String  @db.ObjectId
  imagePath String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour  Colour  @relation(fields: [colourId], references: [id], onDelete: Cascade)

  @@unique([productId, colourId])
}

model Department {
  id                   String @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  sequence             Int
  headcount            Int
  unitsPerWorkerPerDay Float
  maxUnitsPerDay       Int
  headName             String @default("")
  headEmail            String @default("")

  productRates ProductDepartmentRate[]
  ocPlans      OcDepartmentPlan[]
  manpowerPlanLines ManpowerPlanLine[]
}

// Optional per-product override of a department's default rate/ceiling.
// Falls back to the Department row when no override exists.
model ProductDepartmentRate {
  id                   String @id @default(auto()) @map("_id") @db.ObjectId
  productId            String @db.ObjectId
  departmentId         String @db.ObjectId
  unitsPerWorkerPerDay Float
  maxUnitsPerDay       Int

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([productId, departmentId])
}

model ProductMaterial {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  productId       String @db.ObjectId
  materialName    String
  unit            String
  quantityPerUnit Float
  /// Demo on-hand stock for Stage-1 material readiness (not live SAP inventory).
  demoAvailableQty Float @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PricingSlab {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  productId      String @db.ObjectId
  minQuantity    Int
  maxQuantity    Int?
  discountPercent Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Quotation {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  quotationNumber     String   @unique
  productId           String   @db.ObjectId
  quantity            Int
  colourId            String   @db.ObjectId
  unitRate            Float
  lineTotal           Float
  createdAt           DateTime @default(now())
  revisesQuotationNumber String? // set when this quotation was created via "Revise"
  location            String  @default("") // e.g. "Reception", "Workstations" — line description location

  // Customer / commercial party fields on the quotation PDF
  vendorName       String @default("") // customer / bill-to name (legacy field name)
  vendorAddress    String @default("")
  vendorState      String @default("")
  vendorStateCode  String @default("")
  vendorGstin      String @default("")
  shipToName       String @default("")
  shipToAddress    String @default("")
  shipToState      String @default("")
  shipToStateCode  String @default("")
  shipToGstin      String @default("")
  deliveryDate     DateTime?
  contactPerson    String @default("")
  contactPhone     String @default("")
  contactEmail     String @default("")
  buyerName        String @default("")
  vendorRefNo      String @default("") // customer / enquiry ref
  remarks          String @default("")
  paymentTerms     String @default("Advance 100%")
  discountPercent  Float  @default(0)

  product     Product      @relation(fields: [productId], references: [id])
  colour      Colour       @relation(fields: [colourId], references: [id])
  salesOrders SalesOrder[]
}

// Lightweight sales-order gate between customer acceptance and OC release.
// Does not replace Zoho CRM — operational verification only.
model SalesOrder {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  soNumber      String   @unique
  quotationId   String?  @db.ObjectId
  productId     String   @db.ObjectId
  quantity      Int
  colourId      String   @db.ObjectId
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status        String   // confirmed | pending_verification | approved | sent_back | rejected | released
  customerName  String   @default("")
  notes         String   @default("")
  sendBackReason String  @default("")
  rejectReason  String   @default("")

  itemCodeVerified     Boolean @default(false)
  drawingVerified      Boolean @default(false)
  bomVerified          Boolean @default(false)
  orderDetailsVerified Boolean @default(false)

  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?
  releasedAt  DateTime?

  quotation         Quotation?         @relation(fields: [quotationId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  colour            Colour             @relation(fields: [colourId], references: [id])
  orderConfirmation OrderConfirmation?
}

model OrderConfirmation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  ocNumber     String   @unique
  productId    String   @db.ObjectId
  quantity     Int
  colourId     String   @db.ObjectId
  targetDays   Int
  priority     String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  salesOrderId String?  @unique @db.ObjectId
  plannedAt    DateTime @default(now())
  currentStage String
  status       String   // planning | in_progress | closed | cancelled

  product    Product     @relation(fields: [productId], references: [id])
  colour     Colour      @relation(fields: [colourId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])

  plan   OcDepartmentPlan[]
  events OcStageEvent[]
  alerts Alert[]
  manpowerPlan ManpowerPlan?
}

model OcDepartmentPlan {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  ocId            String @db.ObjectId
  departmentId    String @db.ObjectId
  workersRequired Int
  stageHours      Float
  stageDays       Float

  oc         OrderConfirmation @relation(fields: [ocId], references: [id], onDelete: Cascade)
  department Department        @relation(fields: [departmentId], references: [id])
}

model OcStageEvent {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  ocId          String    @db.ObjectId
  stageName     String
  enteredAt     DateTime  @default(now())
  exitedAt      DateTime?
  durationHours Float?
  deadlineDays  Float
  breached      Boolean   @default(false)
  updatedBy     String    @default("") // display name of user who opened/closed the stage

  oc OrderConfirmation @relation(fields: [ocId], references: [id], onDelete: Cascade)
}

// Manpower-efficiency module — Feature spec "Manpower efficiency module".
// One plan per OC (re-computed on every range change, persisted only on
// explicit Save), distinct from OcDepartmentPlan, which is the immutable
// record of the plan made at OC creation time under Scenario 3.
model ManpowerPlan {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  ocId          String   @unique @db.ObjectId
  startDate     DateTime
  endDate       DateTime
  workingDays   Float
  requiredRate  Float?
  status        String   // achievable | blocked
  computedAt    DateTime @default(now())

  oc    OrderConfirmation  @relation(fields: [ocId], references: [id], onDelete: Cascade)
  lines ManpowerPlanLine[]
}

model ManpowerPlanLine {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  planId          String @db.ObjectId
  departmentId    String @db.ObjectId
  workersRequired Int
  workingDays     Float
  workingHours    Float
  manHours        Float
  utilisation     Float // requiredRate / ceiling, e.g. 0.70 = 70%

  plan       ManpowerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  department Department   @relation(fields: [departmentId], references: [id])
}

model Alert {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  ocId           String?  @db.ObjectId
  type           String   // stage_entry | deadline_breach | sales_order_confirmed | follow_up_reminder | escalation
  recipient      String
  recipientEmail String   @default("")
  subject        String
  body           String
  createdAt      DateTime @default(now())
  emailSent      Boolean  @default(false)
  salesOrderId   String?  @db.ObjectId

  oc OrderConfirmation? @relation(fields: [ocId], references: [id], onDelete: Cascade)
}
